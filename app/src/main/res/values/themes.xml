<resources>
    <!-- Dark parent and an explicit window background so launch doesn't flash
         white before Compose paints. -->
    <style name="Theme.RepsRox" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  `monochrome` drives the Android 13+ themed-icon treatment. It reuses the
  foreground because the system replaces that layer's colours with a tint drawn
  from the user's wallpaper, so only the mark's shape and its position inside the
  safe zone matter. Systems below API 33 ignore the tag.

  If the foreground ever gains a gradient or a second colour, split this out into
  a dedicated single-colour drawable — a flattened multi-tone mark reads as a blob.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
